{
  "mcpServers": {
    "chromium-cdp": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "zotero": {
      "type": "http",
      "url": "http://127.0.0.1:47837/mcp",
      "headers": {
        "Connection": "close"
      }
    },
    "grafana": {
      "type": "http",
      "url": "http://localhost:8000/mcp"
    }
  }
}
