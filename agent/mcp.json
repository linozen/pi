{
  "mcpServers": {
    "chromium-cdp": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222",
        "--slim",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "lifecycle": "keep-alive"
    },
    "tableplus": {
      "type": "http",
      "url": "http://127.0.0.1:51003/mcp",
      "headers": {
        "Authorization": "Bearer ${TABLEPLUS_MCP_TOKEN}"
      }
    }
  }
}
